# Optional for public repositories; recommended to avoid low anonymous rate limits.
GITHUB_TOKEN=
# SQLite database used by the synchronous Agent workflow.
AGENT_DB_PATH=data/agent-runs.sqlite3
# Optional OpenCode Zen credential for DeepSeek V4 Flash analysis and reranking.
OPENCODE_API_KEY=
OPENCODE_MAX_OUTPUT_TOKENS=20000
OPENCODE_TIMEOUT_SECONDS=180
OPENCODE_TEMPERATURE=0.1
OPENCODE_MAX_EVIDENCE_CHARS=100000
OPENCODE_MAX_LINES_PER_EVIDENCE=200
