# Optional for public repositories; recommended to avoid low anonymous rate limits.
GITHUB_TOKEN=
# SQLite database used by the synchronous Agent workflow.
AGENT_DB_PATH=data/agent-runs.sqlite3
# Optional OpenAI-compatible API backend. Legacy OPENCODE_* names remain supported.
LLM_BACKEND=api
LLM_API_KEY=
LLM_API_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_PROVIDER=opencode
LLM_MODEL=deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=20000
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.1
LLM_REASONING_EFFORT=none
LLM_RESPONSE_FORMAT_JSON=true
LLM_MAX_EVIDENCE_CHARS=100000
LLM_MAX_LINES_PER_EVIDENCE=200

# Isolated local Codex CLI backend. Fast tier is enabled explicitly with --llm-fast.
CODEX_CLI_EXECUTABLE=codex
CODEX_CLI_MODEL=gpt-5.6-luna
CODEX_CLI_REASONING_EFFORT=medium
CODEX_CLI_TIMEOUT_SECONDS=180
