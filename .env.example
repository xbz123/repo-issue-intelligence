# Optional for public repositories; recommended to avoid low anonymous rate limits.
GITHUB_TOKEN=
# SQLite database used by the synchronous Agent workflow.
AGENT_DB_PATH=data/agent-runs.sqlite3
# Optional Groq inference for evidence-grounded Top-K investigation.
GROQ_API_KEY=
# Optional backup credential. The runtime does not use it unless failover is enabled.
GROQ_API_KEY_FALLBACK=
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_EVIDENCE_CHARS=16000
LLM_MAX_OUTPUT_TOKENS=1600
LLM_TIMEOUT_SECONDS=30
LLM_REASONING_EFFORT=low
